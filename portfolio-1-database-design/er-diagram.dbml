// ShopSphere ER Diagram — DBML source
// Import this file at https://dbdiagram.io/d to generate a clean ER diagram,
// then export it as a PNG and save it as er-diagram.png for submission.

Table customer {
  customer_id bigint [pk, increment]
  first_name varchar [not null]
  last_name varchar [not null]
  email varchar [not null, unique]
  phone varchar
  created_at timestamptz [not null, default: `now()`]
  is_active boolean [not null, default: true]
}

Table address {
  address_id bigint [pk, increment]
  customer_id bigint [not null, ref: > customer.customer_id]
  address_line varchar [not null]
  city varchar [not null]
  region varchar
  postal_code varchar [not null]
  country char(2) [not null]
  is_default boolean [not null, default: false]
}

Table category {
  category_id bigint [pk, increment]
  name varchar [not null]
  parent_id bigint [ref: > category.category_id]
}

Table product {
  product_id bigint [pk, increment]
  sku varchar [not null, unique]
  name varchar [not null]
  description text
  category_id bigint [not null, ref: > category.category_id]
  price numeric(12,2) [not null]
  currency char(3) [not null, default: 'USD']
  stock_qty int [not null, default: 0]
  is_active boolean [not null, default: true]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
}

Table product_attribute {
  attribute_id bigint [pk, increment]
  product_id bigint [not null, ref: > product.product_id]
  attribute_name varchar [not null]
  attribute_value varchar [not null]
}

Table product_image {
  image_id bigint [pk, increment]
  product_id bigint [not null, ref: > product.product_id]
  url varchar [not null, unique]
  alt_text varchar
}

Table shopping_cart {
  cart_id bigint [pk, increment]
  customer_id bigint [not null, unique, ref: > customer.customer_id]
  created_at timestamptz [not null, default: `now()`]
}

Table cart_item {
  cart_item_id bigint [pk, increment]
  cart_id bigint [not null, ref: > shopping_cart.cart_id]
  product_id bigint [not null, ref: > product.product_id]
  quantity int [not null]
}

Table customer_order {
  order_id bigint [pk, increment]
  customer_id bigint [not null, ref: > customer.customer_id]
  order_date timestamptz [not null, default: `now()`]
  status varchar [not null, default: 'PENDING']
  total numeric(14,2) [not null, default: 0]
}

Table order_item {
  order_item_id bigint [pk, increment]
  order_id bigint [not null, ref: > customer_order.order_id]
  product_id bigint [not null, ref: > product.product_id]
  quantity int [not null]
  unit_price numeric(12,2) [not null]
}

Table payment {
  payment_id bigint [pk, increment]
  order_id bigint [not null, ref: > customer_order.order_id]
  amount numeric(14,2) [not null]
  method varchar [not null]
  status varchar [not null, default: 'PENDING']
  reference varchar
  created_at timestamptz [not null, default: `now()`]
}

Table shipment {
  shipment_id bigint [pk, increment]
  order_id bigint [not null, ref: > customer_order.order_id]
  carrier varchar [not null]
  tracking_ref varchar [not null, unique]
  status varchar [not null, default: 'PENDING']
  dispatched_at timestamptz
  delivered_at timestamptz
}
